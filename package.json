{
  "name": "hexo-solitude-tag",
  "version": "2.0.0",
  "description": "Plugin tags used only for Solitude themes",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "eslint": "eslint .",
    "pretest": "pnpm run clean && pnpm run build",
    "test": "tsc -p tsconfig.test.json && mocha '.test-dist/test/**/*.js'",
    "test-cov": "c8 --check-coverage --lines 90 --branches 80 --functions 80 --reporter=text --include='.test-dist/lib/**/*.js' pnpm test",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "directories": {
    "lib": "./lib"
  },
  "files": [
    "dist/**"
  ],
  "types": "./dist/index.d.ts",
  "repository": "everfu/hexo-solitude-tag",
  "homepage": "https://blog.everfu.cn",
  "keywords": [
    "website",
    "blog",
    "cms",
    "framework",
    "hexo"
  ],
  "author": "伍十七 (https://github.com/everfu)",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^4.3.17",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.19.43",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/stylus": "^0.48.43",
    "c8": "^8.0.1",
    "chai": "^4.5.0",
    "cheerio": "1.0.0-rc.12",
    "eslint": "^8.57.0",
    "eslint-config-hexo": "^5.0.0",
    "hexo": "^8.1.2",
    "hexo-renderer-marked": "^7.0.1",
    "jsdom": "^29.1.1",
    "mocha": "^10.7.3",
    "stylus": "^0.64.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "hexo-util": "^4.0.0",
    "js-yaml": "^4.1.1"
  },
  "peerDependencies": {
    "hexo": "^8.0.0"
  }
}
