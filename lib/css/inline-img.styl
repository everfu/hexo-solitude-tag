.article-container img.solitude-tag.tag-image
  display block
  max-width 100%
  height auto
  margin var(--st-space-4) auto
  border 1px solid var(--st-border)
  border-radius var(--st-radius-lg)
  box-shadow var(--st-shadow)

.article-container img.solitude-tag.inline-img
  display inline-block
  width auto
  max-width 100%
  margin 0 var(--st-space-1)
  border 0
  border-radius var(--st-radius-sm)
  box-shadow none
  object-fit cover
  vertical-align -.2em
