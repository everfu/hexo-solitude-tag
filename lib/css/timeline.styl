.article-container .solitude-tag.tag-timeline
  --tag-timeline-color var(--st-accent)
  position relative
  margin var(--st-space-4) 0

  &.red
    --tag-timeline-color var(--efu-red)
  &.green
    --tag-timeline-color var(--efu-green)
  &.blue
    --tag-timeline-color var(--efu-blue)
  &.purple
    --tag-timeline-color var(--efu-purple)
  &.orange
    --tag-timeline-color var(--efu-orange)

  > .timeline-title
    display block
    margin-bottom var(--st-space-3)
    color var(--st-text)
    font-size 1.12rem
    font-weight 750

  .timeline-item
    position relative
    margin-left 10px
    padding 0 0 var(--st-space-4) 28px
    border-left 2px solid var(--st-border)

    &:last-child
      padding-bottom 0
      border-left-color transparent

    &.headline
      padding-bottom var(--st-space-3)
      border-left-color transparent

      .timeline-item-title::before
        width 14px
        height 14px

      .item-circle
        color var(--tag-timeline-color)
        font-size 1.05rem

  .timeline-item-title
    position relative
    min-height 24px
    color var(--st-text)
    font-size .9rem
    font-weight 750
    line-height 1.5

    &::before
      content ''
      position absolute
      top 5px
      left -36px
      width 12px
      height 12px
      border 3px solid var(--st-surface)
      border-radius 50%
      background var(--tag-timeline-color)
      box-shadow 0 0 0 2px var(--st-accent-soft)

    p
      margin 0 !important

  .timeline-item-content,
  .body
    margin-top var(--st-space-2)
    padding var(--st-space-3) var(--st-space-4)
    border 1px solid var(--st-border)
    border-radius var(--st-radius-md)
    background var(--st-surface)
    box-shadow var(--st-shadow)
    color var(--st-text-muted)

    > :first-child
      margin-top 0 !important
    > :last-child
      margin-bottom 0 !important

.article-container .solitude-tag.tag-timenode
  position relative
  margin-left 10px
  padding 0 0 var(--st-space-4) 28px
  border-left 2px solid var(--st-border)

  .meta
    position relative
    min-height 24px
    color var(--st-text)
    font-weight 750

    &::before
      content ''
      position absolute
      top 5px
      left -36px
      width 12px
      height 12px
      border 3px solid var(--st-surface)
      border-radius 50%
      background var(--st-accent)
      box-shadow 0 0 0 2px var(--st-accent-soft)

    p
      margin 0 !important

  .body
    margin-top var(--st-space-2)
    padding var(--st-space-3) var(--st-space-4)
    border 1px solid var(--st-border)
    border-radius var(--st-radius-md)
    background var(--st-surface)
    box-shadow var(--st-shadow)
