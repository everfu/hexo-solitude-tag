.article-container .solitude-tag.tag-choice
  --tag-choice-color var(--efu-blue)
  display flex
  align-items flex-start
  gap var(--st-space-2)
  margin var(--st-space-2) 0
  color var(--st-text)

  &.red
    --tag-choice-color var(--efu-red)
  &.green
    --tag-choice-color var(--efu-green)
  &.yellow
    --tag-choice-color var(--efu-yellow)
  &.cyan
    --tag-choice-color var(--efu-cyan, #1bcdfc)
  &.blue
    --tag-choice-color var(--efu-blue)

  input
    appearance none
    position relative
    flex 0 0 19px
    width 19px
    height 19px
    margin 3px 0 0
    border 2px solid var(--tag-choice-color)
    background var(--st-surface)
    pointer-events none
    transition background var(--st-motion), transform var(--st-motion)

    &:checked
      background var(--tag-choice-color)

    &[type='checkbox']
      border-radius 6px

      &::after
        content ''
        position absolute
        top 2px
        left 5px
        width 5px
        height 9px
        border solid var(--efu-white)
        border-width 0 2px 2px 0
        opacity 0
        transform rotate(45deg) scale(.7)
        transition opacity var(--st-motion), transform var(--st-motion)

      &:checked::after
        opacity 1
        transform rotate(45deg) scale(1)

    &[type='radio']
      border-radius 50%

      &::after
        content ''
        position absolute
        inset 3px
        border-radius 50%
        background var(--efu-white)
        opacity 0
        transform scale(.5)
        transition opacity var(--st-motion), transform var(--st-motion)

      &:checked::after
        opacity 1
        transform scale(1)

  &.minus input[type='checkbox']:checked::after
    top 7px
    left 3px
    width 9px
    height 2px
    border 0
    background var(--efu-white)
    transform none

  &.plus input[type='checkbox']:checked
    &::before,
    &::after
      content ''
      position absolute
      top 7px
      left 3px
      width 9px
      height 2px
      border 0
      background var(--efu-white)
      opacity 1
      transform none
    &::before
      transform rotate(90deg)

  &.times input[type='checkbox']:checked
    &::before,
    &::after
      content ''
      position absolute
      top 7px
      left 3px
      width 9px
      height 2px
      border 0
      background var(--efu-white)
      opacity 1
    &::before
      transform rotate(45deg)
    &::after
      transform rotate(-45deg)

  .tag-choice-content
    min-width 0
    line-height 1.65

    p
      display inline
      margin 0 !important
      font-size inherit
