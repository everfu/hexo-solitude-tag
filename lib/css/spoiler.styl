.article-container .solitude-tag.spoiler
  display inline
  border-radius 5px
  cursor help
  outline none
  transition filter var(--st-motion), background var(--st-motion), color var(--st-motion)

  &:focus-visible
    outline 3px solid var(--st-accent-soft)
    outline-offset 2px

  &.blur-text
    padding 0 3px
    filter blur(4px)
    user-select none

    &:hover,
    &:focus
      filter blur(0)
      user-select auto

  &.block-text
    padding 0 3px
    background var(--st-text)
    color transparent
    user-select none

    &:hover,
    &:focus
      background var(--st-accent-soft)
      color inherit
      user-select auto
