.article-container a.solitude-tag.tag-link
  display block
  margin var(--st-space-4) 0
  padding var(--st-space-3)
  overflow hidden
  border 1px solid var(--st-border)
  border-radius var(--st-radius-lg)
  background var(--st-surface)
  box-shadow var(--st-shadow)
  color var(--st-text) !important
  font-weight 400
  text-decoration none !important
  transition border-color var(--st-motion), box-shadow var(--st-motion), transform var(--st-motion)

  &:hover
    border-color var(--st-accent)
    box-shadow var(--st-shadow-hover)
    transform translateY(-2px)

    .tag-link-bottom > i
      color var(--st-accent)
      transform translateX(3px)

  &:focus-visible
    outline 3px solid var(--st-accent-soft)
    outline-offset 3px

  .tag-link-tips
    display inline-flex
    align-items center
    gap 6px
    margin-bottom var(--st-space-2)
    color var(--st-text-muted)
    font-size .72rem
    font-weight 600

  .tag-link-bottom
    display grid
    grid-template-columns 48px minmax(0, 1fr) auto
    align-items center
    gap var(--st-space-3)

    > i
      color var(--st-text-muted)
      transition color var(--st-motion), transform var(--st-motion)

  .tag-link-left
    display flex
    align-items center
    justify-content center
    width 48px
    height 48px
    overflow hidden
    border-radius var(--st-radius-md)
    background var(--st-accent-soft)
    color var(--st-accent)

    i
      margin 0
      color inherit
      font-size 1.1rem

  .tag-link-right
    min-width 0

  .tag-link-title
    overflow hidden
    color var(--st-text)
    font-size .94rem
    font-weight 750
    text-overflow ellipsis
    white-space nowrap

  .tag-link-sitename
    display -webkit-box
    margin-top 2px
    overflow hidden
    color var(--st-text-muted)
    font-size .78rem
    line-height 1.45
    -webkit-box-orient vertical
    -webkit-line-clamp 2
