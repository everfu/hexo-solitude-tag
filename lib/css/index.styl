.article-container .solitude-tag
  &.red
    color var(--efu-red)
  &.green
    color var(--efu-green)
  &.blue
    color var(--efu-blue)
  &.yellow
    color var(--efu-yellow)
  &.pink
    color var(--efu-pink)
  &.purple
    color var(--efu-purple)
  &.orange
    color var(--efu-orange)

  .bg-red
    background var(--efu-red)
    color var(--efu-white)
  .bg-green
    background var(--efu-green)
    color var(--efu-white)
  .bg-blue
    background var(--efu-blue)
    color var(--efu-white)
  .bg-yellow
    background var(--efu-yellow)
    color var(--efu-black)
  .bg-pink
    background var(--efu-pink)
    color var(--efu-white)
  .bg-purple
    background var(--efu-purple)
    color var(--efu-white)
  .bg-orange
    background var(--efu-orange)
    color var(--efu-white)

  &.block
    display flex
  &.center
    margin-inline auto
  &.right
    margin-left auto
  &.larger
    min-height 48px
    padding-inline var(--st-space-5)
    font-size 1rem

@media (prefers-reduced-motion: reduce)
  .article-container .solitude-tag,
  .article-container .solitude-tag::before,
  .article-container .solitude-tag::after,
  .article-container .solitude-tag *
    scroll-behavior auto !important
    transition-duration .01ms !important
    animation-duration .01ms !important
    animation-iteration-count 1 !important
