.article-container kbd.solitude-tag.keyboard-tag
  display inline-flex
  align-items center
  justify-content center
  min-width 28px
  min-height 26px
  margin 0 var(--st-space-1)
  padding 2px var(--st-space-2)
  border 1px solid var(--st-border)
  border-bottom-width 3px
  border-radius 7px
  background linear-gradient(180deg, var(--st-surface), var(--st-surface-muted))
  box-shadow 0 1px 2px rgba(0, 0, 0, .08)
  color var(--st-text)
  font-family inherit
  font-size .76em
  font-weight 700
  line-height 1
  vertical-align .08em
