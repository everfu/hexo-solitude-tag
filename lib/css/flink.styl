.article-container .solitude-tag.flink
  .flink-list-item
    width calc(100% / 3 - 15px) !important

@media screen and (max-width: 1024px)
  .article-container .solitude-tag.flink
    .flink-list-item
      width calc(50% - 15px) !important

@media screen and (max-width: 600px)
  .article-container .solitude-tag.flink
    .flink-list-item
      width calc(100% - 15px) !important
