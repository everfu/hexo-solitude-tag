$note-colors = {
  info: #3b82f6,
  danger: #ef4444,
  primary: #7c3aed,
  warning: #f59e0b,
  success: #22a06b,
  default: #64748b,
  blue: #3b82f6,
  pink: #db5a91,
  red: #ef4444,
  purple: #7c3aed,
  orange: #f97316,
  green: #22a06b
}

.article-container aside.solitude-tag.note
  --tag-note-color var(--st-accent)
  position relative
  display flex
  align-items flex-start
  gap var(--st-space-3)
  margin var(--st-space-4) 0
  padding var(--st-space-3) var(--st-space-4)
  overflow hidden
  border 1px solid var(--st-border)
  border-left 4px solid var(--tag-note-color)
  border-radius var(--st-radius-md)
  background var(--st-surface-muted)
  color var(--st-text)
  font-size .88rem
  line-height 1.65

  for $name, $value in $note-colors
    &.{$name}
      --tag-note-color $value

  &.simple
    background var(--st-surface)

  &.modern
    border-left-width 1px
    box-shadow var(--st-shadow)

  &.flat
    border-top-color transparent
    border-right-color transparent
    border-bottom-color transparent

  &.disabled
    --tag-note-color var(--st-text-muted)

  .note-icon
    display flex
    flex 0 0 30px
    align-items center
    justify-content center
    width 30px
    height 30px
    border-radius 9px
    background var(--st-surface)
    color var(--tag-note-color)
    font-size .92rem

  > :not(.note-icon)
    min-width 0

  h2,
  h3,
  h4,
  h5,
  h6,
  p
    margin 0 !important
    color inherit
    font-size inherit
    line-height inherit

  a
    color var(--tag-note-color) !important
