.article-container mark.solitude-tag.hl-label
  --tag-label-color var(--st-accent)
  display inline-flex
  align-items center
  margin 0 2px
  padding 2px 8px
  border 1px solid var(--tag-label-color)
  border-radius var(--st-radius-pill)
  background var(--st-surface-muted)
  color var(--tag-label-color)
  font-size .78em
  font-weight 700
  line-height 1.45
  vertical-align .08em

  &.blue
    --tag-label-color var(--efu-blue)
  &.pink
    --tag-label-color var(--efu-pink)
  &.red
    --tag-label-color var(--efu-red)
  &.purple
    --tag-label-color var(--efu-purple)
  &.orange
    --tag-label-color var(--efu-orange)
  &.green
    --tag-label-color var(--efu-green)
